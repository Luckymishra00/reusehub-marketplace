# ReUseHub Marketplace Environment Configuration Example
# Copy to .env and replace placeholder values before running locally.

NODE_ENV=development
PORT=3000

# Relational Database Connection URL
DATABASE_URL=postgresql://postgres:MyDB@2026_Secure@127.0.0.1:5433/app_db

# Optional MySQL 8.0 Connection Parameters (when running migrations/schema.sql on MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=reusehub
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# JWT Authentication Configuration
JWT_ACCESS_SECRET=replacewithawsecurexx64gdfcharertrandomsecret
JWT_ACCESS_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=public/uploads
MAX_UPLOAD_SIZE_MB=5
